# Copy to .env.jitsi (gitignored) before:
#   docker compose -f docker-compose.jitsi.yml --env-file .env.jitsi up -d
#
# Keep JWT_APP_ID / JWT_APP_SECRET in sync with CRM:
#   JITSI_JWT_APP_ID / JITSI_JWT_APP_SECRET

# Host root only — JitsiMeetExternalAPI uses https://{host}/{room}.
# A path-prefix (/meet) breaks the iframe (CRM SPA is loaded instead of Jitsi).
PUBLIC_URL=https://meet.longhuachinese.online
# Keep CRM JITSI_BASE_URL identical. UX stays on CRM /lesson/:id/video.

# JWT-only — no anonymous guests, no personal Jitsi accounts
ENABLE_AUTH=1
AUTH_TYPE=jwt
ENABLE_GUESTS=0
DISABLE_HTTPS=1
JWT_APP_ID=longhua_crm
JWT_APP_SECRET=change-me-long-random-secret
JWT_ACCEPTED_ISSUERS=longhua_crm
JWT_ACCEPTED_AUDIENCES=jitsi

# 1:1 lessons: enable P2P so media works when JVB UDP/10000 ICE fails.
# Jitsi still uses JVB when a 3rd participant joins.
ENABLE_P2P=1
ENABLE_COLIBRI_WEBSOCKET=1
ENABLE_XMPP_WEBSOCKET=1
JVB_WS_SERVER_ID=172.19.0.2
JVB_ADVERTISE_PRIVATE_CANDIDATES=false

# Strong random passwords (required by Prosody / Jicofo / JVB)
JICOFO_AUTH_PASSWORD=change-me-jicofo
JVB_AUTH_PASSWORD=change-me-jvb

# Public IP of this server for WebRTC media (UDP 10000).
# Cloudflare orange-cloud proxies HTTPS only — media must hit this IP:10000/udp.
# Prefer DNS-only (grey cloud) for meet.* OR keep proxy + open UDP 10000 on origin.
JVB_ADVERTISE_IPS=YOUR.PUBLIC.IP

CONFIG=~/.jitsi-meet-cfg
TZ=Europe/Minsk
JITSI_HTTP_PORT=8000
JVB_PORT=10000
