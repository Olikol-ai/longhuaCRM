# Copy to .env.jitsi (gitignored) before:
#   docker compose -f docker-compose.jitsi.yml --env-file .env.jitsi up -d
#
# Keep JWT_APP_ID / JWT_APP_SECRET in sync with CRM:
#   JITSI_JWT_APP_ID / JITSI_JWT_APP_SECRET

# Primary: path-prefix under the CRM host (Cloudflare Tunnel /meet* → :8000)
PUBLIC_URL=https://lk.longhuachinese.online/meet

# Fallback if path-prefix breaks BOSH/WebSocket/colibri:
# PUBLIC_URL=https://meet.longhuachinese.online
# and set CRM JITSI_BASE_URL to the same value (UX still /lesson/:id/video).

# JWT-only — no anonymous guests, no personal Jitsi accounts
ENABLE_AUTH=1
AUTH_TYPE=jwt
ENABLE_GUESTS=0
DISABLE_HTTPS=1
JWT_APP_ID=longhua_crm
JWT_APP_SECRET=change-me-long-random-secret
JWT_ACCEPTED_ISSUERS=longhua_crm
JWT_ACCEPTED_AUDIENCES=jitsi

# Strong random passwords (required by Prosody / Jicofo / JVB)
JICOFO_AUTH_PASSWORD=change-me-jicofo
JVB_AUTH_PASSWORD=change-me-jvb

# Public IP of this server for WebRTC media (UDP 10000). Cloudflare Tunnel does NOT carry media.
JVB_ADVERTISE_IPS=YOUR.PUBLIC.IP

CONFIG=~/.jitsi-meet-cfg
TZ=Europe/Minsk
JITSI_HTTP_PORT=8000
JVB_PORT=10000
