# Copy to .env.jitsi and fill in values before:
#   docker compose -f docker-compose.jitsi.yml --env-file .env.jitsi up -d

# Public HTTPS URL of this Jitsi (must match reverse proxy / TLS).
PUBLIC_URL=https://meet.example.com

# Anonymous guests (no Jitsi registration). CRM passes displayName via External API.
ENABLE_AUTH=0
ENABLE_GUESTS=1

# Strong random passwords (required by Prosody / Jicofo / JVB)
JICOFO_AUTH_PASSWORD=change-me-jicofo
JVB_AUTH_PASSWORD=change-me-jvb

# Optional: CRM-issued HS256 guest JWTs (still no personal Jitsi accounts)
# ENABLE_AUTH=1
# AUTH_TYPE=jwt
# JWT_APP_ID=longhua_crm
# JWT_APP_SECRET=change-me-long-random-secret
# JWT_ACCEPTED_ISSUERS=longhua_crm
# JWT_ACCEPTED_AUDIENCES=jitsi
# Then in LonghuaCRM .env:
#   JITSI_BASE_URL=https://meet.example.com
#   JITSI_JWT_APP_ID=longhua_crm
#   JITSI_JWT_APP_SECRET=change-me-long-random-secret

CONFIG=~/.jitsi-meet-cfg
TZ=Europe/Minsk
JITSI_HTTP_PORT=8000
JITSI_HTTPS_PORT=8443
JVB_PORT=10000
