{
  "name": "longhua-crm",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\" \"npm run tunnel\"",
    "dev:client": "vite",
    "dev:server": "npm run migration:run --prefix apps/api && npm run start:dev --prefix apps/api",
    "tunnel": "bash scripts/run-cloudflare-tunnel.sh",
    "build": "npm run build:api && npm run build:client",
    "build:client": "node scripts/build-client-preserve-assets.mjs",
    "build:client:fresh": "vite build",
    "build:api": "npm run build --prefix apps/api",
    "clean:api": "node -e \"require('fs').rmSync('apps/api/dist',{recursive:true,force:true}); try{require('fs').unlinkSync('apps/api/tsconfig.build.tsbuildinfo')}catch(e){}; try{require('fs').unlinkSync('apps/api/tsconfig.tsbuildinfo')}catch(e){}\"",
    "lint": "eslint . --quiet",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p ./jsconfig.json",
    "preview": "vite preview",
    "start": "npm run start:prod --prefix apps/api",
    "start:production": "npm run clean:api && npm run build && npm run start:prod --prefix apps/api",
    "migration:run": "npm run migration:run --prefix apps/api",
    "migration:revert": "npm run migration:revert --prefix apps/api",
    "db:backup": "bash scripts/backup-db.sh",
    "db:backup:docker": "bash scripts/backup-db.sh --docker",
    "db:restore": "bash scripts/restore-db.sh",
    "test:e2e": "npm run test:e2e --prefix apps/api",
    "seed:assessment-demo": "npm run seed:assessment-demo --prefix apps/api -- --yes",
    "test": "npm run test:unit && npm run test --prefix apps/api",
    "test:unit": "node --test src/lib/materialMeta.test.js src/lib/forgotPasswordUi.test.js src/lib/lessonPayload.test.js src/lib/passwordPolicy.test.js src/lib/certificatesPayload.test.js src/lib/time-slots.test.js src/lib/teacherPayPeriods.test.js src/lib/studentLabels.test.js src/lib/schoolSchedule.contract.test.js src/lib/locale-by.contract.test.js src/lib/tutor-materials.contract.test.js src/lib/assessment-authoring.contract.test.js src/lib/exam-blocks.contract.test.js src/lib/routing.acl.contract.test.js src/lib/main-module-nav.contract.test.js src/pages/Salary.contract.test.js src/pages/LowBalanceStudents.contract.test.js src/pages/Settings.contract.test.js src/pages/Profile.contract.test.js src/lib/display-name.test.js src/lib/homework.contract.test.js src/lib/lesson-video.contract.test.js src/lib/student-registration.contract.test.js src/lib/ownerStudents.contract.test.js src/lib/chats-privacy.contract.test.js src/lib/chats-persistence.contract.test.js src/lib/chats-lesson-scope.contract.test.js src/lib/e2ee/e2ee.roundtrip.test.js src/lib/e2ee/crypto-normalize.test.js src/lib/presence-format.test.js src/lib/invite-links.contract.test.js src/lib/lazyRetry.contract.test.js",
    "test:browser": "playwright test",
    "test:browser:report": "node e2e/browser/merge-audit-report.mjs",
    "mobile": "npm run start --prefix apps/mobile",
    "mobile:android": "npm run android --prefix apps/mobile",
    "mobile:ios": "npm run ios --prefix apps/mobile",
    "mobile:prebuild": "npm run prebuild --prefix apps/mobile"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^17.0.0",
    "@hookform/resolvers": "^4.1.2",
    "@noble/curves": "^1.9.0",
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-alert-dialog": "^1.1.6",
    "@radix-ui/react-aspect-ratio": "^1.1.2",
