# Allow deploy/ops (user ilya) to manage LonghuaCRM systemd units without a password.
ilya ALL=(root) NOPASSWD: \
  /usr/bin/systemctl start longhua.service, \
  /usr/bin/systemctl stop longhua.service, \
  /usr/bin/systemctl restart longhua.service, \
  /usr/bin/systemctl reload longhua.service, \
  /usr/bin/systemctl try-reload-or-restart longhua.service, \
  /usr/bin/systemctl status longhua.service, \
  /usr/bin/systemctl is-active longhua.service, \
  /usr/bin/systemctl is-enabled longhua.service, \
  /usr/bin/systemctl show longhua.service, \
  /usr/bin/systemctl cat longhua.service, \
  /usr/bin/systemctl start cloudflared-longhua.service, \
  /usr/bin/systemctl stop cloudflared-longhua.service, \
  /usr/bin/systemctl restart cloudflared-longhua.service, \
  /usr/bin/systemctl reload cloudflared-longhua.service, \
  /usr/bin/systemctl try-reload-or-restart cloudflared-longhua.service, \
  /usr/bin/systemctl status cloudflared-longhua.service, \
  /usr/bin/systemctl is-active cloudflared-longhua.service, \
  /usr/bin/systemctl is-enabled cloudflared-longhua.service, \
  /usr/bin/systemctl show cloudflared-longhua.service, \
  /usr/bin/systemctl cat cloudflared-longhua.service, \
  /usr/bin/systemctl enable cloudflared-longhua.service, \
  /usr/bin/systemctl disable cloudflared-longhua.service, \
  /usr/bin/systemctl daemon-reload, \
  /bin/systemctl start longhua.service, \
  /bin/systemctl stop longhua.service, \
