# =============================================================================
# Longhua Academy — Environment variables
# Copy to .env and adjust values. Never commit .env to version control.
# =============================================================================

# --- Core ---
NODE_ENV=development
PORT=3001
LOG_LEVEL=log

# PostgreSQL connection string (required)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/longhua

# --- Security (required in production) ---
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated allowed browser origins for CORS (required in production if APP_PUBLIC_URL is unset)
# CORS_ORIGINS=https://crm.example.com,https://www.example.com

# Public URL of the app (used for links in emails/Telegram and default CORS in production)
# APP_PUBLIC_URL=https://crm.example.com

# Trust reverse proxy (set true behind nginx/traefik)
TRUST_PROXY=false

# Rate limiting (requests per window per IP)
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=120

# Serve built SPA from API (set false when frontend is on CDN/separate host)
SERVE_FRONTEND=true

# --- Admin bootstrap (first run creates admin if password is set) ---
ADMIN_EMAIL=admin@longhua.local
ADMIN_PASSWORD=

# --- Mail / SMTP (verification codes, notifications) ---
MAIL_HOST=
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=
MAIL_PASS=
MAIL_FROM="Longhua Academy <noreply@example.com>"

# --- Telegram Bot ---
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=
# Canonical webhook endpoint (HTTPS via Cloudflare Tunnel):
#   https://lk.longhuachinese.online/api/telegram/webhook
# Required when TELEGRAM_MODE=webhook (and in production by default).
TELEGRAM_WEBHOOK_URL=https://lk.longhuachinese.online/api/telegram/webhook
# Shared secret for header x-telegram-bot-api-secret-token (required in production webhook mode)
TELEGRAM_WEBHOOK_SECRET=
# polling = local Nest → Telegram getUpdates (clears webhook on start — never with prod bot + tunnel)
# webhook = setWebhook using TELEGRAM_WEBHOOK_URL (left registered across restarts)
# When unset: polling outside production, webhook in production
# For https://lk.longhuachinese.online (Cloudflare tunnel) use webhook:
TELEGRAM_MODE=webhook
# IMPORTANT: use true/false only. Parsing is strict — string "false" must stay false.
TELEGRAM_MOCK=false
TELEGRAM_BOT_USERNAME=LonghuaChinese_bot
# Behind Cloudflare Tunnel / reverse proxy:
TRUST_PROXY=true

# --- Scheduled jobs (lesson reminders, cleanup) ---
ENABLE_CRON=true
REMINDER_TIMEZONE=Europe/Minsk
PENDING_REGISTRATION_TTL_HOURS=24

# --- Alfa Bank Belarus (optional online payments) ---
ALFA_BANK_TOKEN=
ALFA_BANK_MERCHANT_ID=
ALFA_BANK_API_URL=https://pay.alfabank.by/api
# Webhook callbacks (register both in merchant cabinet if needed):
#   POST {APP_PUBLIC_URL}/api/webhooks/alfabank
#   POST {APP_PUBLIC_URL}/api/payments/alfa/webhook
# Sandbox API often uses https://web.rbsuat.com/ab_by/api (ask AlfaBank for current URL)

# --- E2E / CI only ---
# E2E_SYNC_SCHEMA=true
# E2E_DROP_SCHEMA=true
# ADMIN_EMAIL=admin@test.local
# ADMIN_PASSWORD=TestAdmin123!
